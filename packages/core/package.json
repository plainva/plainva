{
  "name": "@plainva/core",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "main": "./dist/public.js",
  "types": "./dist/public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "node": "./dist/node.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "node": "./dist/sqlite.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plainva/plainva.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "description": "Markdown, frontmatter, links, tasks and indexed vault queries for local-first tools.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "smoke:package": "node scripts/pack-smoke.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "benchmark": "tsx scripts/benchmark.ts",
    "fuzz:workspace": "tsx scripts/workspace-fuzz.ts",
    "vectors:workspace": "tsx scripts/workspace-vectors.ts"
  },
  "dependencies": {
    "@hpke/chacha20poly1305": "^1.8.0",
    "@hpke/core": "^1.9.0",
    "@hpke/dhkem-x25519": "^1.8.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "fast-xml-parser": "^5.11.1",
    "ical.js": "^2.2.1",
    "node-diff3": "^3.2.1",
    "parse5": "^7.3.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "peerDependenciesMeta": {
    "sqlite": {
      "optional": true
    },
    "sqlite3": {
      "optional": true
    }
  }
}
