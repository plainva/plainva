{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Permissions for the central window (owner). It alone owns the background services, every write path and the window management; auxiliary windows run on the smaller, separate set in aux.json.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "core:window:allow-available-monitors",
    "core:webview:allow-set-webview-zoom",
    "core:webview:allow-create-webview-window",
    "dialog:default",
    "store:default",
    "opener:default",
    "opener:allow-open-path",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }, { "path": "/*/**" }, { "path": "**/.*" }, { "path": "**/.*/**" }, { "path": "/*/**/.*" }, { "path": "/*/**/.*/**" }]
    },
    "opener:allow-reveal-item-in-dir",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [{ "url": "https://**:*" }, { "url": "http://**:*" }]
    },
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "fs:default",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-stat",
    "fs:allow-watch",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "**" }, { "path": "/*/**" }, { "path": "**/.*" }, { "path": "**/.*/**" }, { "path": "/*/**/.*" }, { "path": "/*/**/.*/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "**" }, { "path": "/*/**" }, { "path": "**/.*" }, { "path": "**/.*/**" }, { "path": "/*/**/.*" }, { "path": "/*/**/.*/**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "**" }, { "path": "/*/**" }, { "path": "**/.*" }, { "path": "**/.*/**" }, { "path": "/*/**/.*" }, { "path": "/*/**/.*/**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "**" }, { "path": "/*/**" }, { "path": "**/.*" }, { "path": "**/.*/**" }, { "path": "/*/**/.*" }, { "path": "/*/**/.*/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "**" }, { "path": "/*/**" }, { "path": "**/.*" }, { "path": "**/.*/**" }, { "path": "/*/**/.*" }, { "path": "/*/**/.*/**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "**" }, { "path": "/*/**" }, { "path": "**/.*" }, { "path": "**/.*/**" }, { "path": "/*/**/.*" }, { "path": "/*/**/.*/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "**" }, { "path": "/*/**" }, { "path": "**/.*" }, { "path": "**/.*/**" }, { "path": "/*/**/.*" }, { "path": "/*/**/.*/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "**" }, { "path": "/*/**" }, { "path": "**/.*" }, { "path": "**/.*/**" }, { "path": "/*/**/.*" }, { "path": "/*/**/.*/**" }]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [{ "path": "**" }, { "path": "/*/**" }, { "path": "**/.*" }, { "path": "**/.*/**" }, { "path": "/*/**/.*" }, { "path": "/*/**/.*/**" }]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [{ "path": "**" }, { "path": "/*/**" }, { "path": "**/.*" }, { "path": "**/.*/**" }, { "path": "/*/**/.*" }, { "path": "/*/**/.*/**" }]
    },
    {
      "identifier": "fs:allow-watch",
      "allow": [{ "path": "**" }, { "path": "/*/**" }, { "path": "**/.*" }, { "path": "**/.*/**" }, { "path": "/*/**/.*" }, { "path": "/*/**/.*/**" }]
    },
    "updater:default",
    "notification:default",
    "autostart:default",
    "process:default"
  ]
}
