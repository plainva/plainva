{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "aux-window",
  "description": "Permissions for auxiliary windows (aux-*, compose-*). They render content, read the vault and the index directly, and hand every mutation to the owner window over the window bus. Deliberately smaller than the owner set: no updater, no process control, no notifications, no autostart, no window creation, no file watcher, no filesystem writes, no SQL writes and no settings writes — all of that belongs to the one window that owns the background services.",
  "windows": ["aux-*", "compose-*"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-current-monitor",
    "core:webview:allow-set-webview-zoom",
    "dialog:default",
    "store:default",
    "opener:default",
    "opener:allow-open-path",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }, { "path": "/*/**" }, { "path": "**/.*" }, { "path": "**/.*/**" }, { "path": "/*/**/.*" }, { "path": "/*/**/.*/**" }]
    },
    "opener:allow-reveal-item-in-dir",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [{ "url": "https://**:*" }, { "url": "http://**:*" }]
    },
    "sql:default",
    "fs:default",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:allow-stat",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "**" }, { "path": "/*/**" }, { "path": "**/.*" }, { "path": "**/.*/**" }, { "path": "/*/**/.*" }, { "path": "/*/**/.*/**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "**" }, { "path": "/*/**" }, { "path": "**/.*" }, { "path": "**/.*/**" }, { "path": "/*/**/.*" }, { "path": "/*/**/.*/**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "**" }, { "path": "/*/**" }, { "path": "**/.*" }, { "path": "**/.*/**" }, { "path": "/*/**/.*" }, { "path": "/*/**/.*/**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "**" }, { "path": "/*/**" }, { "path": "**/.*" }, { "path": "**/.*/**" }, { "path": "/*/**/.*" }, { "path": "/*/**/.*/**" }]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [{ "path": "**" }, { "path": "/*/**" }, { "path": "**/.*" }, { "path": "**/.*/**" }, { "path": "/*/**/.*" }, { "path": "/*/**/.*/**" }]
    }
  ]
}
