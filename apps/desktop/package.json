{
  "name": "desktop",
  "private": true,
  "version": "0.8.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:isolated": "vite --port 1440 --strictPort",
    "dev:labs": "vite --port 1450 --strictPort --mode labs",
    "tauri:isolated": "node scripts/fetch-onnxruntime.mjs && tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:labs": "node scripts/fetch-onnxruntime.mjs && cargo build --manifest-path src-tauri/Cargo.toml --bin plainva-mcp && tauri dev --config src-tauri/tauri.labs.conf.json",
    "build": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc && vite build",
    "lint": "eslint .",
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config playwright.prod.config.ts",
    "smoke:prod": "pnpm build && pnpm test:e2e:prod",
    "perf:browser": "vite build && playwright test --config playwright.perf.config.ts",
    "build:e2e": "vite build --mode e2e",
    "preview:e2e": "vite preview --mode e2e --port 4175 --strictPort",
    "scan:engine-floor": "node scripts/scan-engine-floor.mjs",
    "test:native": "wdio run ./wdio.conf.ts",
    "test:native:updater": "wdio run ./wdio.updater.conf.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.4",
    "@plainva/core": "workspace:*",
    "@plainva/ui": "workspace:*",
    "@tauri-apps/api": "~2.12.0",
    "@tauri-apps/plugin-autostart": "~2.6.0",
    "@tauri-apps/plugin-dialog": "~2.8.0",
    "@tauri-apps/plugin-fs": "~2.6.0",
    "@tauri-apps/plugin-global-shortcut": "~2.4.0",
    "@tauri-apps/plugin-http": "~2.8.0",
    "@tauri-apps/plugin-notification": "~2.5.0",
    "@tauri-apps/plugin-opener": "~2.6.0",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-sql": "~2.5.0",
    "@tauri-apps/plugin-store": "~2.5.0",
    "@tauri-apps/plugin-updater": "~2.13.0",
    "@uiw/codemirror-extensions-basic-setup": "^4.25.12",
    "d3-force": "^3.0.1",
    "d3-hierarchy": "^3.1.3",
    "d3-quadtree": "^3.0.2",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "i18next": "^26.7.1",
    "katex": "^0.19.1",
    "lucide": "^1.70.0",
    "lucide-react": "^1.70.0",
    "mermaid": "^11.17.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-quadtree": "^3.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@wdio/cli": "9",
    "@wdio/local-runner": "9",
    "@wdio/mocha-framework": "9",
    "@wdio/spec-reporter": "9",
    "@wdio/tauri-service": "1.5.1",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "webdriverio": "9"
  }
}
