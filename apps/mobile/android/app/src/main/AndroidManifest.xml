<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth redirect (M3): the system browser returns to the app via
                 com.plainva.app://oauth after provider consent. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.plainva.app" />
            </intent-filter>

            <!-- Share target (package J): plain text becomes a captured note;
                 images and arbitrary files (single or multiple) are saved as
                 vault attachments and embedded/linked in a new note.
                 ShareTargetPlugin buffers, the JS shell polls on resume. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- Static launcher shortcuts (package J): new note / today. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Live QR scanning (encrypted-workspace pairing) runs through
         getUserMedia in the WebView. Capacitor's WebChromeClient requests
         CAMERA when the page asks for a video stream, but Android denies a
         permission the app never declares — so the scanner failed instantly
         with "camera unavailable" while @capacitor/camera's photo capture kept
         working (it goes through an IMAGE_CAPTURE intent, no permission
         needed). Optional feature: phones without a camera stay installable. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Appointment reminders (S10). From Android 13 a notification is not
         shown at all without this permission, and the request dialog cannot
         even appear for an app that does not declare it. SCHEDULE_EXACT_ALARM
         is deliberately NOT declared: it is a restricted permission Google
         reviews, and a reminder that is a minute late is still a reminder —
         `allowWhileIdle` is enough to survive Doze. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
