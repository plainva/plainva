<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cleartext http is permitted because a self-hosted server on a home
         network is a normal thing to sync against, and it usually speaks http.
         Since targetSdk 28 the platform default is to refuse those connections
         outright — before a single packet leaves — which made self-hosted
         WebDAV and a local MinIO unreachable from the phone while the desktop
         handled them fine (issue #48).

         This does NOT weaken https: the flag only decides whether the platform
         rejects an http URL on its own. TLS, certificate validation against the
         system/user trust stores and failure on an invalid certificate remain.

         The real boundary is ours and stays where it was: WebDavHttpPlugin
         admits only origins the user configured plus fixed https-only provider
         hosts, checked per redirect HOP. Because an origin carries its scheme,
         a server that answers an https request with a redirect to http lands on
         an origin nobody allowed and is refused there. -->
    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth redirect (M3): the system browser returns to the app via
                 com.plainva.app://oauth after provider consent. The scheme is
                 the application id, so the Labs build (com.plainva.app.labs)
                 answers on its own scheme and never takes the store app's. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" />
            </intent-filter>

            <!-- Share target (package J): plain text becomes a captured note;
                 images and arbitrary files (single or multiple) are saved as
                 vault attachments and embedded/linked in a new note.
                 ShareTargetPlugin buffers, the JS shell polls on resume. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- Static launcher shortcuts (package J): new note / today. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <!-- Home-screen widgets (plan Widgets, W3). The app has had neither a
             receiver nor a service before this; both are new here.

             A widget provider MUST be exported - the system is what sends it
             APPWIDGET_UPDATE - so neither of these two does anything a foreign
             intent could abuse: they read a file and redraw. Everything that
             CHANGES something (ticking a task off) goes through
             WidgetTapReceiver below, which is not exported. -->
        <receiver
            android:name=".TodayWidgetProvider"
            android:label="@string/widget_today_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <receiver
            android:name=".CaptureWidgetProvider"
            android:label="@string/widget_capture_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_capture_info" />
        </receiver>

        <!-- Where a tap on a row lands. NOT exported: the app's own
             PendingIntents reach it, and nothing else does. -->
        <receiver
            android:name=".WidgetTapReceiver"
            android:exported="false" />

        <!-- The list of the "Today" widget. BIND_REMOTEVIEWS is what lets the
             launcher bind to it, and declaring the permission here means only
             the system can. -->
        <service
            android:name=".TodayWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Live QR scanning (encrypted-workspace pairing) runs through
         getUserMedia in the WebView. Capacitor's WebChromeClient requests
         CAMERA when the page asks for a video stream, but Android denies a
         permission the app never declares — so the scanner failed instantly
         with "camera unavailable" while @capacitor/camera's photo capture kept
         working (it goes through an IMAGE_CAPTURE intent, no permission
         needed). Optional feature: phones without a camera stay installable. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Voice memos (plan Journal-Erweiterungen, X4) go through MediaRecorder
         in the WebView, so the same rule as the QR scanner applies: Capacitor's
         WebChromeClient asks for RECORD_AUDIO when the page requests an audio
         stream, and Android denies a permission the app never declares. Asked
         on the first tap of the microphone, never at startup. Optional
         feature: a device without a microphone stays installable. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- A place stamp on a journal entry (plan Journal-Erweiterungen, X7),
         opt-in per device and off by default. COARSE only: four decimals of
         a degree say which building, and an entry does not need to say which
         room. Asked on the first press of the button, never at startup, and
         never in the background - there is no tracking here, only one
         position at the moment someone asks for it. Optional feature: a
         device without a receiver stays installable. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- Appointment reminders (S10). From Android 13 a notification is not
         shown at all without this permission, and the request dialog cannot
         even appear for an app that does not declare it. SCHEDULE_EXACT_ALARM
         is deliberately NOT declared: it is a restricted permission Google
         reviews, and a reminder that is a minute late is still a reminder —
         `allowWhileIdle` is enough to survive Doze. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The device's calendars as a calendar account (EventKit / CalendarContract plan,
         2026-09-04): runtime permission, asked only when the account is created. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
</manifest>
