<?xml version="1.0" encoding="utf-8"?>
<!-- A capture target. Bordered rather than filled: two filled buttons side by
     side would read as one block, and these are two separate places to go. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_bg_muted" />
    <stroke android:width="1dp" android:color="@color/widget_border" />
    <corners android:radius="@dimen/widget_inner_radius" />
</shape>
