<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's own surface. The corner radius comes from the system
     (Android 12+ exposes it as @android:dimen/system_app_widget_background_radius);
     below that a fixed 16dp, which is what the platform used before. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_bg" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
