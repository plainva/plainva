{
  "name": "mobile",
  "private": true,
  "version": "0.6.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:isolated": "vite --port 1441 --strictPort",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "sync": "cap sync",
    "test": "vitest run",
    "baseline": "node scripts/screenshot-baseline.mjs",
    "smoke:prod": "vite build && playwright test --config playwright.prod.config.ts"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/dialog": "^8.0.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@plainva/core": "workspace:*",
    "@plainva/ui": "workspace:*",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "i18next": "^26.3.6",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "webdav-server": "^2.6.3"
  }
}
