"Open a note in ${applicationName}" = "Ouvre une note dans ${applicationName}";
"Open ${note} in ${applicationName}" = "Ouvre ${note} dans ${applicationName}";
"Search in ${applicationName}" = "Cherche dans ${applicationName}";
"Search ${applicationName}" = "Rechercher dans ${applicationName}";
