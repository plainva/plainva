"New journal entry in ${applicationName}" = "Neuer Journal-Eintrag in ${applicationName}";
"Add a task in ${applicationName}" = "Aufgabe in ${applicationName} hinzufügen";
"New task in ${applicationName}" = "Neue Aufgabe in ${applicationName}";
"Open a note in ${applicationName}" = "Notiz in ${applicationName} öffnen";
