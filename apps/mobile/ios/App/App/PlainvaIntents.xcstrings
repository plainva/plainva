    "Notes what you say as an entry of today's journal. Plainva writes it down when it is next opened.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält fest, was Du sagst, als Eintrag im Journal von heute. Plainva schreibt ihn auf, sobald es das nächste Mal geöffnet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes what you say as an entry of today's journal. Plainva writes it down when it is next opened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota lo que dices como una entrada del diario de hoy. Plainva la escribe la próxima vez que se abre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note ce que vous dites comme une entrée du journal du jour. Plainva l'écrit à sa prochaine ouverture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annota ciò che dici come voce del diario di oggi. Plainva la scrive alla prossima apertura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話した内容を今日のジャーナルの記入として控えます。次にPlainvaを開いたときに書き込まれます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noteert wat je zegt als item in het journaal van vandaag. Plainva schrijft het op zodra het de volgende keer wordt geopend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapamiętuje to, co powiesz, jako wpis w dzisiejszym dzienniku. Plainva zapisze go przy następnym otwarciu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota o que você diz como uma entrada do diário de hoje. O Plainva a escreve na próxima vez que for aberto."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "把你说的话记为今天日志中的一条。Plainva会在下次打开时写入。"
          }
        }
      }
    },
