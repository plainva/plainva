    "Notes what you say as a task. Plainva creates it when it is next opened.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält fest, was Du sagst, als Aufgabe. Plainva legt sie an, sobald es das nächste Mal geöffnet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes what you say as a task. Plainva creates it when it is next opened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota lo que dices como una tarea. Plainva la crea la próxima vez que se abre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note ce que vous dites comme une tâche. Plainva la crée à sa prochaine ouverture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annota ciò che dici come attività. Plainva la crea alla prossima apertura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話した内容をタスクとして控えます。次にPlainvaを開いたときに作成されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noteert wat je zegt als taak. Plainva maakt haar zodra het de volgende keer wordt geopend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapamiętuje to, co powiesz, jako zadanie. Plainva utworzy je przy następnym otwarciu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota o que você diz como uma tarefa. O Plainva a cria na próxima vez que for aberto."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "把你说的话记为一项任务。Plainva会在下次打开时创建它。"
          }
        }
      }
