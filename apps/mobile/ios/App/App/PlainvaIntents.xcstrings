    "Noted. Plainva writes it into the journal when it is next opened.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiert. Plainva trägt es ins Journal ein, sobald es das nächste Mal geöffnet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noted. Plainva writes it into the journal when it is next opened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anotado. Plainva lo escribe en el diario la próxima vez que se abre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est noté. Plainva l'écrira dans le journal à sa prochaine ouverture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotato. Plainva lo scrive nel diario alla prossima apertura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "控えました。次にPlainvaを開いたときにジャーナルに書き込まれます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Genoteerd. Plainva zet het in het journaal zodra het de volgende keer wordt geopend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanotowano. Plainva zapisze to w dzienniku przy następnym otwarciu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anotado. O Plainva escreve isso no diário na próxima vez que for aberto."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已记下。Plainva会在下次打开时写入日志。"
          }
        }
      }
    },
    "Plainva could not take this right now.": {
